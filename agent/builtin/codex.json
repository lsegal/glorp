{
  "name": "codex",
  "binary": "codex",
  "levels": ["low", "medium", "high"],
  "args": {
    "run": [
      { "args": ["exec"] },
      { "args": ["--dangerously-bypass-approvals-and-sandbox"], "when": "yolo" },
      { "args": ["--model", "${model}"], "when": "model" },
      { "args": ["-c", "model_reasoning_effort=${level}"], "when": "level" },
      { "args": ["${prompt}"] }
    ],
    "resume": [
      { "args": ["exec", "resume"] },
      { "args": ["--dangerously-bypass-approvals-and-sandbox"], "when": "yolo" },
      { "args": ["${session}"] },
      { "args": ["${prompt}"] }
    ],
    "vision": [
      { "args": ["exec", "--image", "${image}"] },
      { "args": ["--dangerously-bypass-approvals-and-sandbox"], "when": "yolo" },
      { "args": ["--model", "${model}"], "when": "model" },
      { "args": ["-c", "model_reasoning_effort=${level}"], "when": "level" },
      { "args": ["${prompt}"] }
    ]
  },
  "session": {
    "assign": false,
    "capturePattern": "(?i)session id:\\s*([0-9a-f]{8}-[0-9a-f-]{27,})",
    "clearOnResumeFailure": true
  },
  "output": { "format": "text" },
  "quota": { "reader": "codex" }
}
